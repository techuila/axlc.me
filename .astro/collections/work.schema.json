{
  "$ref": "#/definitions/work",
  "definitions": {
    "work": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "work",
            "project"
          ],
          "default": "work"
        },
        "period": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "location": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "current": {
          "type": "boolean",
          "default": false
        },
        "order": {
          "type": "number",
          "default": 99
        },
        "externalUrl": {
          "type": "string",
          "format": "uri"
        },
        "coolLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "repo": {
          "type": "string",
          "pattern": "^[\\w.-]+\\/[\\w.-]+$"
        },
        "logo": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "imageAlt": {
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "period",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}