---
import { BRANDS } from '@/utils/brands';

export interface Props {
  id: string;
}

const { id } = Astro.props;
const brand = BRANDS[id];
const split = brand && brand.panes.length === 2;
---

{
  brand && (
    <div class:list={['brand-cover', split && 'split']}>
      {brand.panes.map((pane, i) => (
        <div
          class:list={['pane', split && (i === 0 ? 'left' : 'right'), pane.topImg && 'has-top']}
          style={`--g1:${pane.from};--g2:${pane.to}`}
        >
          {pane.topImg && (
            <img
              class="brand-top"
              src={pane.topImg}
              alt=""
              loading="lazy"
              decoding="async"
              style={pane.topImgWidth ? `width:${pane.topImgWidth}` : undefined}
            />
          )}
          {pane.img && (
            <img
              src={pane.img}
              alt={pane.alt ?? ''}
              loading="lazy"
              decoding="async"
              class:list={[pane.invert && 'invert']}
              style={pane.logoWidth ? `width:${pane.logoWidth}` : undefined}
            />
          )}
          {pane.text && (
            <span
              class:list={['brand-text', pane.img && 'wordmark', pane.big && 'big', pane.textClass]}
              style={pane.textColor ? `color:${pane.textColor}` : undefined}
            >
              {pane.text}
            </span>
          )}
          {pane.accent && (
            <span class="brand-accent" style={`background:${pane.accent}`} aria-hidden="true" />
          )}
        </div>
      ))}
    </div>
  )
}
