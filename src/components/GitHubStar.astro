---
/**
 * "Star on GitHub" button for open-source projects.
 *
 * - `cta`: the big attention-grabbing pill on a project page. Idle it
 *   twinkles and a light sweeps across it; hover fills the star gold;
 *   click pops a burst of sparks before the repo opens in a new tab.
 * - `chip`: a compact star + count badge that sits on a work card's
 *   thumbnail (cards are one big link, so the chip lives outside it).
 *
 * The live star count comes from the public GitHub API on the client,
 * cached in localStorage for an hour, and rolls up from 0 when it comes
 * into view. Without a count (offline, rate-limited) the button still
 * works as a plain link.
 */
export interface Props {
  repo: string; // "owner/name"
  variant?: 'cta' | 'chip';
}

const { repo, variant = 'cta' } = Astro.props;
const href = `https://github.com/${repo}`;
const name = repo.split('/')[1] ?? repo;
---

<a
  class:list={['gh-star', `gh-star-${variant}`]}
  href={href}
  target="_blank"
  rel="noopener"
  data-gh-star={repo}
  aria-label={`Star ${name} on GitHub`}
  title={`Star ${name} on GitHub`}
>
  <span class="gh-star-sheen" aria-hidden="true"></span>
  <span class="gh-star-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="16" height="16">
      <path
        class="gh-star-shape"
        d="M12 2.6l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.5l-5.9 3.1 1.2-6.5L2.5 9.5l6.6-.9z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"></path>
    </svg>
  </span>
  {
    variant === 'cta' && (
      <span class="gh-star-label">
        <span class="gh-star-word">Star on GitHub</span>
      </span>
    )
  }
  <span class="gh-star-count" data-count hidden>
    <span class="gh-star-num" data-num>0</span>
  </span>
  {
    variant === 'cta' && (
      <span class="gh-star-mark" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </span>
    )
  }
  <span class="gh-star-burst" aria-hidden="true">
    {Array.from({ length: 10 }).map((_, i) => <i style={`--i:${i}`} />)}
  </span>
</a>

<script>
  const TTL = 60 * 60 * 1000;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const fmt = (n: number) =>
    n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, '')}k` : String(n);

  const cached = (repo: string): number | null => {
    try {
      const raw = localStorage.getItem(`gh-stars:${repo}`);
      if (!raw) return null;
      const { n, t } = JSON.parse(raw);
      return Date.now() - t < TTL ? n : null;
    } catch {
      return null;
    }
  };

  const fetchStars = async (repo: string): Promise<number | null> => {
    const hit = cached(repo);
    if (hit !== null) return hit;
    try {
      const res = await fetch(`https://api.github.com/repos/${repo}`, {
        headers: { Accept: 'application/vnd.github+json' },
      });
      if (!res.ok) return null;
      const n = (await res.json()).stargazers_count as number;
      try {
        localStorage.setItem(`gh-stars:${repo}`, JSON.stringify({ n, t: Date.now() }));
      } catch {
        /* storage unavailable */
      }
      return n;
    } catch {
      return null;
    }
  };

  // Roll the number up from 0 the first time the button is on screen.
  const roll = (el: HTMLElement, target: number) => {
    if (reduce || target === 0) {
      el.textContent = fmt(target);
      return;
    }
    const start = performance.now();
    const dur = 900 + Math.min(900, target * 12);
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = fmt(Math.round(target * eased));
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const buttons = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-gh-star]'));
  const byRepo = new Map<string, HTMLAnchorElement[]>();
  buttons.forEach((b) => {
    const repo = b.dataset.ghStar as string;
    byRepo.set(repo, [...(byRepo.get(repo) ?? []), b]);
  });

  byRepo.forEach(async (els, repo) => {
    const n = await fetchStars(repo);
    if (n === null) return;
    els.forEach((el) => {
      const count = el.querySelector<HTMLElement>('[data-count]');
      const num = el.querySelector<HTMLElement>('[data-num]');
      if (!count || !num) return;
      count.hidden = false;
      el.classList.add('has-count');
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          roll(num, n);
          io.disconnect();
        }
      });
      io.observe(el);
    });
  });

  // Click: sparks fly and the star stays lit. The link opens in a new tab
  // on its own, so nothing here blocks navigation.
  buttons.forEach((b) => {
    b.addEventListener('click', () => {
      b.classList.add('is-starred');
      if (reduce) return;
      b.classList.remove('is-burst');
      void b.offsetWidth;
      b.classList.add('is-burst');
      setTimeout(() => b.classList.remove('is-burst'), 900);
    });
  });
</script>
