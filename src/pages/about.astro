---
import Base from "@/layouts/Base.astro";
import { AppConfig } from "@/utils/AppConfig";

const values = [
  "Own systems beyond initial implementation.",
  "Prefer simple solutions with clear operational behavior.",
  "Treat tests as part of system design, not an afterthought.",
  "Document technical decisions and their trade-offs.",
  "Improve systems incrementally rather than rewriting prematurely.",
  "Use AI-generated code only after review, validation, and testing.",
  "Work across backend, frontend, infrastructure, QA, and product boundaries when delivery needs it.",
];

const experience = [
  {
    when: "03/2022 – 07/2026",
    where: "Remote · PH",
    role: "Platform Software Engineer",
    org: "Viyahe / Monark",
    url: "https://monark.gg",
    lede: "Core engineer on trials.gg, a challenge-based reward system for competitive gamers — from initial architecture to production launch.",
    bullets: [
      "Delivered end to end (architecture → production); 900+ sign-ups, ~5 hrs/day average engagement, 99.9% availability.",
      "Designed the AWS data-analytics pipeline; near-real-time Grafana dashboards.",
      "Owned CI/CD on AWS CodePipeline across frontend and backend — ~5 deploys/week.",
      "Shipped 35+ web/Electron features while supporting frontend delivery (2023–2024).",
      "Enforced clean-code architecture and team-wide standards.",
    ],
    stack: "Node.js · TypeScript · Fastify · AWS · PostgreSQL · DynamoDB",
  },
  {
    when: "03/2025 – 05/2025",
    where: "Remote · PH",
    role: "DevOps Consultant",
    org: "PH Live Music LTD",
    url: "https://www.linkedin.com/company/phlivemusic",
    lede: "Short freelance engagement focused on cloud cost and delivery reliability.",
    bullets: [
      "Cut infrastructure cost ~70% via AWS migration, right-sizing, and eliminating unused resources.",
      "CI/CD automation: pipeline runtime ~20 → ~6 min; failure rate under 7%.",
      "Fixed TypeScript build/module-resolution issues, stabilizing CI; hardened platform security.",
    ],
    stack: "AWS · CI/CD · TypeScript · security",
  },
  {
    when: "09/2021 – 10/2023",
    where: "Remote · PH",
    role: "Senior Software Engineer Consultant",
    org: "MDI Novare",
    url: "https://www.novare.com.ph",
    lede: "Led the BFA module team on Meralco's Bayad Center project — technical design, backend development, testing, and delivery.",
    bullets: [
      "Designed and shipped backend features on AWS from project requirements.",
      "Built integration tests per feature, strengthening regression protection.",
      "Mentored developers via code reviews and engineering standards.",
      "Ran knowledge-transfer sessions through final handover; retained across successive contract renewals.",
    ],
    stack: "Node.js · AWS · integration testing · mentoring",
  },
  {
    when: "08/2019 – 03/2022",
    where: "Zamboanga · PH",
    role: "Deputy Head Software Developer",
    org: "exact construct GmbH",
    url: "https://www.exact-construct.ch",
    lede: "Second-in-command for engineering: standards, mentoring, and delivery across multiple client projects.",
    bullets: [
      "Led code reviews, technical training, and best-practice guidance.",
      "Designed and delivered web apps with React, Express, and GraphQL.",
      "Owned GitLab CI/CD and development infrastructure; maintained production servers.",
    ],
    stack: "React · Express · GraphQL · GitLab CI",
  },
];

const timeline = [
  {
    label: "Platform Software Engineer — Viyahe / Monark",
    note: "",
    when: "2022 – 2026",
  },
  {
    label: "DevOps Consultant — PH Live Music LTD",
    note: "(freelance)",
    when: "2025",
  },
  {
    label: "Senior Software Engineer Consultant — MDI Novare",
    note: "(freelance)",
    when: "2021 – 2023",
  },
  {
    label: "Deputy Head Software Developer — exact construct GmbH",
    note: "",
    when: "2019 – 2022",
  },
  {
    label: "BS Computer Science — Western Mindanao State University",
    note: "(major in IT)",
    when: "degree",
  },
];

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: AppConfig.url },
    {
      "@type": "ListItem",
      position: 2,
      name: "About",
      item: `${AppConfig.url}/about/`,
    },
  ],
};

const nowStamp = new Date().toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
});
---

<Base
  title="About — Axl Cuyugan"
  description="Software Engineer with 7+ years building and running production web services — architecture, delivery, testing, deployment, cost, and operations."
  path="/about/"
  nav="about"
  back={{ href: "/" }}
  ogType="profile"
  jsonLd={[breadcrumbLd]}
>
  <section class="page-head">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/">home</a>
      <span class="sep" aria-hidden="true">&gt;</span>
      <span class="current" aria-current="page">about</span>
    </nav>
    <h1>Software Engineer who stays for the operations</h1>
    <p class="lede" style="color:var(--fg)">
      I've spent 7+ years building and running production web services from the
      Philippines, mostly with distributed remote teams. The pattern across my
      roles: join early, take ownership of architecture and delivery, then stay
      accountable for what happens after launch - testing, deployment, cost, and
      the 2 a.m. debugging.
    </p>
    <p class="lede">
      Most recently I led backend and cloud delivery for trials.gg at
      Viyahe/Monark. Before that: consulting on Meralco's Bayad Center platform
      with MDI Novare, and deputy head of development at exact construct GmbH.
    </p>
  </section>

  <section style="padding:0 0 52px" aria-labelledby="about-values">
    <h2 class="eyebrow" id="about-values" style="margin-bottom:8px">
      Engineering values
    </h2>
    <ol class="values">
      {values.map((value, i) => (
        <li>
          <span class="num">{String(i + 1).padStart(2, "0")}</span>
          <span>{value}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="two-col" style="padding:0 0 52px">
    <div>
      <h2 class="eyebrow">Environment</h2>
      <p>
        Remote-first, async-heavy, lean teams where engineers hold real
        ownership. Comfortable as the senior engineer who bridges product and
        infrastructure.
      </p>
    </div>
    <div>
      <h2 class="eyebrow">Interests</h2>
      <p>
        Distributed systems and event-driven architecture, testing strategy,
        cloud cost engineering, observability, and disciplined AI-assisted
        development.
      </p>
    </div>
  </section>

  <section style="padding:0 0 52px" aria-labelledby="about-experience">
    <h2 class="eyebrow" id="about-experience" style="margin-bottom:6px">
      Experience
    </h2>
    {experience.map((job) => (
      <article class="xp">
        <div class="when">
          {job.when}
          <br />
          {job.where}
        </div>
        <div>
          <h3>
            {job.role} ·{" "}
            <a class="org" href={job.url} target="_blank" rel="noopener">
              {job.org}
              <span class="ext" aria-hidden="true">
                {" "}
                ↗
              </span>
            </a>
          </h3>
          <p class="xp-lede">{job.lede}</p>
          <ul>
            {job.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
          <p class="stack">{job.stack}</p>
        </div>
      </article>
    ))}
  </section>

  <section style="padding:0 0 52px" aria-labelledby="about-timeline">
    <h2 class="eyebrow" id="about-timeline">Timeline</h2>
    <div class="row-list" style="margin-top:10px">
      {timeline.map((item) => (
        <div class="row">
          <span style="font-size:15px">
            {item.label}{" "}
            {item.note && <span style="color:var(--muted)">{item.note}</span>}
          </span>
          <span class="leader" aria-hidden="true" />
          <span class="row-meta">{item.when}</span>
        </div>
      ))}
    </div>
  </section>

  <section style="padding:0 0 12px" aria-labelledby="about-contact">
    <h2 class="eyebrow" id="about-contact" style="margin-bottom:12px">
      Contact
    </h2>
    <div class="contact-links">
      <a href={`mailto:${AppConfig.email}`}>{AppConfig.email}</a>
      <a href={AppConfig.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
      <a href={AppConfig.github} target="_blank" rel="noopener">GitHub ↗</a>
      <a href={AppConfig.resume} target="_blank" rel="noopener">Resume.pdf</a>
    </div>
  </section>
</Base>
