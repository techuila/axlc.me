---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

import ArticleRow from "@/components/ArticleRow.astro";
import OpenToWorkPill from "@/components/OpenToWorkPill.astro";
import WorkCard from "@/components/WorkCard.astro";
import Base from "@/layouts/Base.astro";
import { AppConfig } from "@/utils/AppConfig";
import { byDateDesc, draftSort, isPublished } from "@/utils/content";

// Every content/work/*.mdx entry shows here: employment first (current,
// then by order), side projects last behind a divider.
const byOrder = (a: CollectionEntry<"work">, b: CollectionEntry<"work">) =>
  Number(b.data.current) - Number(a.data.current) ||
  a.data.order - b.data.order;
const all = await getCollection("work");
const work = all.filter((e) => e.data.kind === "work").sort(byOrder);
const projects = all.filter((e) => e.data.kind === "project").sort(byOrder);

const writing = await getCollection("writing");
const published = writing.filter(isPublished).sort(byDateDesc);
const drafts = writing.filter((p) => !isPublished(p)).sort(draftSort);
const homePosts = [...published, ...drafts].slice(0, 4);

const now = new Date();
const nowStamp = now.toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
});
---

<Base
  title={AppConfig.title}
  description={AppConfig.description}
  path="/"
  ogType="profile"
>
  <section class="hero">
    <div class="portrait-wrap">
      <div class="portrait">
        <img
          src="/assets/images/avatar.JPG"
          alt="Portrait of Axl Cuyugan"
          width="84"
          height="84"
        />
      </div>
      <OpenToWorkPill variant="badge" />
    </div>
    <p class="eyebrow">
      Senior Software Engineer — Backend &amp; Cloud Systems
    </p>
    <h1>Axl Oliver Cuyugan</h1>
    <p class="tagline">
      Senior software engineer building reliable cloud products.<br />
      On the side, I'm building
      <a href="/work/conose-ph/">Conose PH</a>
      and <a href="/work/top-notch/">Top.Notch</a>, two personal projects.
    </p>
  </section>

  <section class="block" aria-labelledby="home-work">
    <div class="section-head">
      <h2 class="eyebrow" id="home-work">Work</h2>
      <span style="display:flex;align-items:center;gap:14px">
        <span style="display:flex;gap:2px">
          <button
            type="button"
            class="carousel-btn"
            data-carousel-prev
            aria-label="Scroll work backward"
            >‹
          </button>
          <button
            type="button"
            class="carousel-btn"
            data-carousel-next
            aria-label="Scroll work forward"
            >›
          </button>
        </span>
        <a href="/work/" class="mono-link">all work →</a>
      </span>
    </div>
    <div
      class="carousel-wrap"
      data-carousel
      tabindex="0"
      aria-label="Selected work — scroll horizontally"
    >
      {work.map((entry) => <WorkCard entry={entry} variant="carousel" />)}
      {
        projects.length > 0 && (
          <>
            <div class="carousel-sep" role="separator" aria-label="Side projects">
              <span class="sep-line" aria-hidden="true" />
              <span class="sep-label">Side projects</span>
              <span class="sep-line" aria-hidden="true" />
            </div>
            {projects.map((entry) => (
              <WorkCard entry={entry} variant="carousel" />
            ))}
          </>
        )
      }
    </div>
  </section>

  <section class="block" aria-labelledby="home-writing">
    <div class="section-head">
      <h2 class="eyebrow" id="home-writing">Writing</h2>
      <a href="/writing/" class="mono-link">all writing →</a>
    </div>
    <div class="row-list">
      {homePosts.map((post) => <ArticleRow post={post} />)}
    </div>
  </section>

  <script>
    const wrap = document.querySelector<HTMLElement>("[data-carousel]");
    document
      .querySelector("[data-carousel-prev]")
      ?.addEventListener("click", () =>
        wrap?.scrollBy({ left: -320, behavior: "smooth" })
      );
    document
      .querySelector("[data-carousel-next]")
      ?.addEventListener("click", () =>
        wrap?.scrollBy({ left: 320, behavior: "smooth" })
      );
  </script>
</Base>
