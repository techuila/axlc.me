---
import { getCollection } from 'astro:content';

import OpenToWorkPill from '@/components/OpenToWorkPill.astro';
import WorkCard from '@/components/WorkCard.astro';
import Base from '@/layouts/Base.astro';
import { AppConfig } from '@/utils/AppConfig';

// Every content/work/*.mdx entry is listed; add a file and it appears.
// `kind: work` entries are employment; `kind: project` entries are side
// projects and get their own section below.
const work = await getCollection('work');
const byOrder = (a: (typeof work)[number], b: (typeof work)[number]) =>
  a.data.order - b.data.order;
const jobs = work.filter((e) => e.data.kind === 'work');
const current = jobs.filter((e) => e.data.current).sort(byOrder);
const past = jobs.filter((e) => !e.data.current).sort(byOrder);
const [pastLead, ...pastRest] = past;
const projects = work.filter((e) => e.data.kind === 'project').sort(byOrder);

// Shown in place of "Current" while there is no current employer.
const hireReasons = [
  'I adapt quickly. Android, PHP, React, Node, Go, Flutter, Rust, Swift: seven roles, no two with the same stack, and I was useful in each within weeks, not months.',
  'I stay for what happens after launch. I have owned systems from the first diagram to production and then kept them running: 99.9% availability on trials.gg, ~40% off an AWS bill, a pipeline cut from 20 minutes to 6.',
  'I have worked remote and async for 5+ years on small teams that ship, and I write things down so the next person does not have to ask.',
  'I build products end to end when nobody is paying me to (see Side projects below). Imagine what happens when someone is.',
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: AppConfig.url },
    { '@type': 'ListItem', position: 2, name: 'Work', item: `${AppConfig.url}/work/` },
  ],
};
---

<Base
  title="Work — Axl Cuyugan"
  description="Work experience and side projects: backend and cloud systems for trials.gg, Meralco's Bayad Center, exact construct, and personal products like Conose PH, Guhit Studio, Finova, and Top.Notch."
  path="/work/"
  nav="work"
  back={{ href: '/' }}
  jsonLd={[breadcrumbLd]}
>
  <section class="page-head" style="padding-bottom:40px">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/">home</a>
      <span class="sep" aria-hidden="true">&gt;</span>
      <span class="current" aria-current="page">work</span>
    </nav>
    <h1>Work</h1>
  </section>

  {
    current.length === 0 && (
      <section style="padding:0 0 52px;max-width:720px" aria-labelledby="work-hire">
        <div class="section-head-rule">
          <h2 class="eyebrow" id="work-hire">Hire me</h2>
          <span class="rule" aria-hidden="true" />
        </div>
        <div class="hire">
          <OpenToWorkPill />
          <h3>Your team could be next on this list.</h3>
          <p class="hire-lede">
            I'm between roles right now, which means no notice period and a lot
            of energy for the next thing. A few reasons this might be a good
            idea:
          </p>
          <ol class="hire-reasons">
            {hireReasons.map((reason, i) => (
              <li>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <span>{reason}</span>
              </li>
            ))}
          </ol>
          <div class="contact-links">
            <a href={`mailto:${AppConfig.email}`}>Email me</a>
            <a href={AppConfig.cv} target="_blank" rel="noopener">CV.pdf</a>
            <a href={AppConfig.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          </div>
        </div>
      </section>
    )
  }

  {
    current.length > 0 && (
      <section style="padding:0 0 44px;max-width:720px" aria-labelledby="work-current">
        <div class="section-head-rule">
          <h2 class="eyebrow" id="work-current">Current</h2>
          <span class="rule" aria-hidden="true" />
        </div>
        {current.map((entry) => <WorkCard entry={entry} variant="hero" />)}
      </section>
    )
  }

  <section style="padding:0 0 52px;max-width:720px" aria-labelledby="work-past">
    <div class="section-head-rule">
      <h2 class="eyebrow" id="work-past">Past experience</h2>
      <span class="rule" aria-hidden="true"></span>
    </div>
    {pastLead && <WorkCard entry={pastLead} variant="hero" />}
    {
      pastRest.length > 0 && (
        <div class="card-grid">
          {pastRest.map((entry) => <WorkCard entry={entry} variant="grid" />)}
        </div>
      )
    }
  </section>

  {
    projects.length > 0 && (
      <section style="padding:0 0 12px;max-width:720px" aria-labelledby="work-projects">
        <div class="section-head-rule">
          <h2 class="eyebrow" id="work-projects">Side projects</h2>
          <span class="rule" aria-hidden="true" />
        </div>
        <div class="card-grid" style="margin-top:0">
          {projects.map((entry) => <WorkCard entry={entry} variant="grid" />)}
        </div>
      </section>
    )
  }
</Base>
